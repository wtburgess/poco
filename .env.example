# Copy to .env for local function testing (never commit real values).
# Generate the VAPID pair with:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects the cron endpoint. Set the same value in Vercel project settings.
CRON_SECRET=

# Subscription storage. Add the Upstash Redis (or Vercel KV) integration in the
# Vercel dashboard and these are injected automatically. Locally, paste them here.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- No-database alternative (single device) ---
# Instead of Upstash, paste ONE push subscription JSON here and redeploy.
# PUSH_SUBSCRIPTION={"endpoint":"...","keys":{"p256dh":"...","auth":"..."}}
